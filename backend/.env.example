DB_URL=jdbc:postgresql://localhost:5432/dzimbahub
DB_USER=postgres
DB_PASSWORD=change-me
APP_JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
APP_JWT_EXPIRATION_MS=86400000
PORT=8080

# Frontend origin(s) allowed to call the API (comma separated). Set this to your Vercel URL in production.
CORS_ORIGINS=http://localhost:3000

# First administrator (created only if no administrator exists yet)
ADMIN_EMAIL=admin@yourdomain.example
ADMIN_PASSWORD=choose-a-long-unique-password
ADMIN_NAME=System Administrator
ADMIN_PHONE=+263770000000

# Demo accounts and listings. Use false in production.
SEED_DEMO_DATA=true
SEED_DEMO_PASSWORD=Demo#12345

# Text-message sign-in codes
SMS_PROVIDER=console          # console (writes the SMS to the server log) or twilio
OTP_EXPOSE_CODE=false         # DEVELOPMENT ONLY: true shows the code on the login screen
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Sign-in code channel: sms (default), twilio-whatsapp (Twilio WhatsApp Sandbox) or whatsapp (Meta Cloud API)
OTP_CHANNEL=twilio-whatsapp
# Twilio WhatsApp (uses TWILIO_ACCOUNT_SID and TWILIO_AUTH_TOKEN above)
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_WHATSAPP_CONTENT_SID=   # optional
# --- Meta Cloud API (only for OTP_CHANNEL=whatsapp; needs a verified business)
# WhatsApp Business Cloud API (Meta Business Manager -> WhatsApp -> API Setup)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=         # use a permanent System User token, not the 24-hour test token
WHATSAPP_TEMPLATE_NAME=dzimbahub_login_code
WHATSAPP_TEMPLATE_LANG=en
WHATSAPP_DEFAULT_COUNTRY_CODE=263
WHATSAPP_FALLBACK_TO_SMS=true  # send by SMS if WhatsApp fails
